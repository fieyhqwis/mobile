-- MAIN LOOP
-- ------------------------------------------
bindConn(RunService.RenderStepped, function()
    Camera = Workspace.CurrentCamera or Camera

    -- FOV + watermark
    if FOVCircle then
        local mousePos = UserInputService:GetMouseLocation()
        local fovVis = Settings.FOVEnabled
            and Settings.AimbotEnabled
            and not (Settings.Spinbot or Settings.AutoTarget)
        FOVCircle.Position = mousePos
        FOVCircle.Radius   = Settings.FOVRadius
        FOVCircle.Visible  = fovVis

        if Watermark then
            if Settings.WatermarkEnabled then
                Watermark.Visible = true
                Watermark.Text = string.format(
                    "Hardcok v3 | Aim:%s(%s) Silent:%s Spin:%s ESP:%s",
                    Settings.AimbotEnabled and "ON" or "OFF",
                    Settings.Mode,
                    Settings.Silent and "ON" or "OFF",
                    Settings.Spinbot and "ON" or "OFF",
                    Settings.ESPMode
                )
            else
                Watermark.Visible = false
            end
        end
    end

    -- Aimbot
    local wantAim = Settings.AimbotEnabled and (isRMBHeld or Settings.AutoTarget or not Settings.HoldToAim)
    if wantAim then
        local target = getClosestTarget()
        if target then
            DBG.aimFound += 1
            local smoothness = (Settings.Mode == "Rage") and 0.95 or 0.15
            local camPos = Camera.CFrame.Position
            local dir = target.Position - camPos
            if dir.Magnitude > 0.05 and math.abs(dir.Unit.Y) < 0.995 then
                local goal = CFrame.new(camPos, target.Position)
                if goal.Position.X == goal.Position.X then -- NaN guard
                    Camera.CFrame = Camera.CFrame:Lerp(goal, smoothness)
                end
            end
            if Settings.AutoShoot and mouse1click then pcall(mouse1click) end
        end
    end

    -- Spinbot
    if Settings.Spinbot and LocalPlayer.Character then
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(Settings.SpinSpeed), 0)
        end
    end

    -- Silent gate
    SILENT.v2active = Settings.Silent
    SILENT.active   = false

    -- ESP pass
    local chamsSet = computeChamsSet()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if not ESPStorage[p] then createESP(p) end
            updateChams(p, chamsSet)
            updateDrawing2D(p)
        end
    end
end)

