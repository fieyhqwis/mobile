Rayfield:LoadConfiguration()
task.defer(function()
    local function pull(flag, cur)
        local v = Rayfield.GetFlag and Rayfield:GetFlag(flag) or nil
        if v == nil then return cur end
        if type(cur) == "boolean" then return (v == true) end
        if type(cur) == "number"  then return tonumber(v) or cur end
        if type(cur) == "string"  then return type(v) == "table" and v[1] or v end
        return v
    end
    Settings.AimbotEnabled    = pull("Aimbot",          Settings.AimbotEnabled)
    Settings.Mode             = pull("AimMode",         Settings.Mode)
    Settings.HoldToAim        = pull("HoldToAim",       Settings.HoldToAim)
    Settings.TargetPart       = pull("AimTargetPart",   Settings.TargetPart)
    Settings.TeamCheck        = pull("TeamCheck",       Settings.TeamCheck)
    Settings.WallCheck        = pull("WallCheck",       Settings.WallCheck)
    Settings.NPCCheck         = pull("NPCCheck",        Settings.NPCCheck)
    Settings.Silent           = pull("Silent",          Settings.Silent)
    Settings.AutoTarget       = pull("AutoTarget",      Settings.AutoTarget)
    Settings.AutoShoot        = pull("AutoShoot",       Settings.AutoShoot)
    Settings.Spinbot          = pull("Spinbot",         Settings.Spinbot)
    Settings.SpinSpeed        = pull("SpinSpeed",       Settings.SpinSpeed)
    Settings.FOVEnabled       = pull("FOVEnabled",      Settings.FOVEnabled)
    Settings.FOVRadius        = pull("FOVRadius",       Settings.FOVRadius)
    Settings.WatermarkEnabled = pull("Watermark",       Settings.WatermarkEnabled)
    Settings.ClickTP          = pull("ClickTP",         Settings.ClickTP)
    Settings.ESPMode          = pull("ESPMode",         Settings.ESPMode)
    Settings.ChamsEnemiesOnly = pull("ChamsEnemiesOnly",Settings.ChamsEnemiesOnly)
    Settings.ChamsMaxDist     = pull("ChamsMaxDist",    Settings.ChamsMaxDist)
    Settings.ShowName         = pull("ShowName",        Settings.ShowName)
    Settings.ShowDistance     = pull("ShowDistance",    Settings.ShowDistance)
    Settings.ShowTeam         = pull("ShowTeam",        Settings.ShowTeam)
    Settings.ShowHP           = pull("ShowHP",          Settings.ShowHP)
end)

