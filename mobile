local STATE = STATE
local bindConn = (STATE and STATE.connect) or function(s, fn) return s:Connect(fn) end

local isRMBHeld, isAltHeld = false, false

bindConn(UserInputService.InputBegan, function(input, gpe)
    if input.KeyCode == Enum.KeyCode.LeftAlt then isAltHeld = true; return end
    if gpe then return end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then isRMBHeld = true; return end

    -- Click TP
    if not Settings.ClickTP then return end
    if not isAltHeld then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end

    local char = LocalPlayer.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    local cam  = Workspace.CurrentCamera
    if not (cam and hrp and hum and hum.Health > 0) then return end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { char, cam }
    params.IgnoreWater = true
    params.RespectCanCollide = true
    local mousePos = UserInputService:GetMouseLocation()
    local ray = cam:ViewportPointToRay(mousePos.X, mousePos.Y)
    local hit = Workspace:Raycast(ray.Origin, ray.Direction * 2000, params)
    local pos = hit and hit.Position or (ray.Origin + ray.Direction * 500)
    pcall(function() char:PivotTo(CFrame.new(pos + Vector3.new(0, 3, 0))) end)
    DBG.tp += 1
end)

bindConn(UserInputService.InputEnded, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then isRMBHeld = false end
    if input.KeyCode == Enum.KeyCode.LeftAlt then isAltHeld = false end
end)

-- ------------------------------------------
-- SILENT AIM — fixed signature
-- Old v2 used a strict "origin == cam.CFrame.Position" + "mag 150-1500" check
-- that rejected anything not matching exactly. New approach: only check the
-- workspace argument + reasonable range, plus an opt-in method whitelist
-- (Raycast / FindPartOnRayWithIgnoreList) so we don't grab unrelated raycasts.
-- ------------------------------------------
getgenv().HARDCOK_SILENT = getgenv().HARDCOK_SILENT or {}
local SILENT = getgenv().HARDCOK_SILENT
SILENT.active   = false
SILENT.v2active = false

SILENT.getTargetPos = function()
    local part = getSilentTarget()
    return part and part.Position or nil
end

if SILENT.v2hooked ~= true or SILENT.dmRef ~= game then
    SILENT.v2hooked = true
    SILENT.dmRef    = game
    local old
    old = hookmetamethod(game, "__namecall", function(self, ...)
        if checkcaller() then return old(self, ...) end
        if SILENT._inHook then return old(self, ...) end
        if not SILENT.v2active then return old(self, ...) end

        local method = getnamecallmethod()
        if method ~= "Raycast" or self ~= Workspace then
            return old(self, ...)
        end

        SILENT._inHook = true
        local args = { ... }
        DBG.hookCalls += 1
        local ok, redirect, params = pcall(function()
            local origin, direction = args[1], args[2]
            if typeof(origin) ~= "Vector3" or typeof(direction) ~= "Vector3" then return nil end
            local cam = Workspace.CurrentCamera
            if not cam then return nil end
            -- Looser than v2: only reject obviously-not-a-shot shapes
            local mag = direction.Magnitude
            if mag < 1 or mag > 5000 then return nil end
            DBG.hookMatch += 1
            local targetPos = SILENT.getTargetPos()
            if not targetPos then DBG.hookNoTarget += 1; return nil end
            local toTarget = targetPos - origin
            local tDist = toTarget.Magnitude
            if tDist < 0.05 then return nil end
            return toTarget.Unit * mag, args[3]
        end)
        SILENT._inHook = false
        if not ok then DBG.hookErr = tostring(redirect) end
        if ok and redirect then
            DBG.hookRedirect += 1
            return old(self, args[1], redirect, params)
        end
        return old(self, ...)
    end)
end

-- ------------------------------------------
-- ESP
-- ------------------------------------------
local ESPStorage = {}
local HIGHLIGHT_BUDGET = 24

local function removeESP(player)
    local d = ESPStorage[player]
    if not d then return end
    if d.Box       then pcall(function() d.Box.Visible = false; d.Box:Remove() end) end
    if d.Text      then pcall(function() d.Text.Visible = false; d.Text:Remove() end) end
    if d.Highlight then pcall(function() d.Highlight:Destroy() end) end
    ESPStorage[player] = nil
end

local function createESP(player)
    if player == LocalPlayer then return end
    removeESP(player)
    local box, text
    if FOVCircle then
        box = Drawing.new("Square")
        box.Thickness = 1.5; box.Filled = false; box.Transparency = 1; box.Visible = false
        text = Drawing.new("Text")
        text.Size = 14; text.Center = true; text.Outline = true
        text.OutlineColor = Color3.fromRGB(0, 0, 0); text.Visible = false
    end
    ESPStorage[player] = { Box = box, Text = text, Highlight = nil }
end

local function computeChamsSet()
    local cam = Workspace.CurrentCamera
    local want = {}
    if Settings.ESPMode ~= "Chams" or not cam then return want end
    local myPos = cam.CFrame.Position
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            if not (Settings.ChamsEnemiesOnly and not isEnemy(p)) then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart") or p.Character.PrimaryPart
                if hrp then
                    local d = (hrp.Position - myPos).Magnitude
                    if d <= Settings.ChamsMaxDist then want[p] = d end
                end
            end
        end
    end
    local n = 0
    for _ in pairs(want) do n += 1 end
    if n > HIGHLIGHT_BUDGET then
        local sorted = {}
        for p, d in pairs(want) do sorted[#sorted + 1] = { p = p, d = d } end
        table.sort(sorted, function(a, b) return a.d < b.d end)
        local keep = {}
        for i = 1, HIGHLIGHT_BUDGET do keep[sorted[i].p] = sorted[i].d end
        return keep
    end
    return want
end

local function updateChams(player, chamsSet)
    local d = ESPStorage[player]
    if not d then return end
    local char = player.Character
    if not char then return end
    local wantChams = chamsSet and chamsSet[player] ~= nil
    if d.Highlight and d.Highlight.Parent ~= char then
        pcall(function() d.Highlight:Destroy() end)
        d.Highlight = nil
    end
    if wantChams then
        if not d.Highlight then
            local hl = Instance.new("Highlight")
            hl.Name = "HC_Chams"
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = char
            d.Highlight = hl
        end
        local c = getTeamColor(player)
        d.Highlight.FillColor           = c
        d.Highlight.OutlineColor        = Color3.fromRGB(255, 255, 255)
        d.Highlight.FillTransparency    = 0.55
        d.Highlight.OutlineTransparency = 0
        d.Highlight.Enabled             = true
    else
        if d.Highlight then
            pcall(function() d.Highlight:Destroy() end)
            d.Highlight = nil
        end
    end
end

local function updateDrawing2D(player)
    local d = ESPStorage[player]
    if not d or not d.Box then return end
    local espActive = (Settings.ESPMode == "Drawing 2D") or (Settings.ESPMode == "Chams")
    local char = player.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if espActive and Settings.ESPMode == "Chams" and Settings.ChamsEnemiesOnly and not isEnemy(player) then
        espActive = false
    end
    if not espActive or not (char and hrp and hum and hum.Health > 0) then
        d.Box.Visible  = false
        d.Text.Visible = false
        return
    end
    local vec, onScreen = Camera:WorldToViewportPoint(hrp.Position)
    if not onScreen then
        d.Box.Visible = false; d.Text.Visible = false; return
    end
    local teamColor = getTeamColor(player)
    local head    = char:FindFirstChild("Head")
    local headVec = head and Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or vec
    local legVec  = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
    local height  = math.abs(headVec.Y - legVec.Y)
    local width   = height / 1.5

    if Settings.ESPMode == "Drawing 2D" then
        d.Box.Size     = Vector2.new(width, height)
        d.Box.Position = Vector2.new(vec.X - width / 2, vec.Y - height / 2)
        d.Box.Color    = teamColor
        d.Box.Visible  = true
    else
        d.Box.Visible = false
    end

    local info = {}
    if Settings.ShowName     then info[#info+1] = player.Name end
    if Settings.ShowTeam     then
        local role = tostring(player:GetAttribute("Role") or "?"):upper()
        info[#info+1] = "[" .. role .. "]"
    end
    if Settings.ShowHP       then info[#info+1] = "HP " .. math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth) end
    if Settings.ShowDistance then info[#info+1] = math.floor((Camera.CFrame.Position - hrp.Position).Magnitude) .. "m" end

    d.Text.Text     = table.concat(info, " | ")
    d.Text.Position = Vector2.new(vec.X, vec.Y - (height / 2) - 20)
    d.Text.Color    = teamColor
    d.Text.Visible  = true
end

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then createESP(p) end
end
bindConn(Players.PlayerAdded, createESP)
bindConn(Players.PlayerRemoving, removeESP)

