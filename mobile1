local isRMBHeld = false
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        isRMBHeld = true
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        isRMBHeld = false
    end
end)

-- ------------------------------------------
-- MAIN LOOP — 360 aimbot
-- 1) Find the closest visible enemy (3D distance, any direction).
-- 2) Capped-lerp the camera toward their head by MaxSnapDeg per frame.
-- 3) If the target is already on-screen, snap exactly.
-- ------------------------------------------
RunService.RenderStepped:Connect(function()
    Camera = Workspace.CurrentCamera or Camera

    if Settings.AimbotEnabled and (not IS_MOBILE or isRMBHeld == false) then
        local target = getClosestTarget()
        if target then
            local camPos = Camera.CFrame.Position
            local dir = target.Position - camPos
            local mag = dir.Magnitude
            if mag > 0.05 and math.abs(dir.Unit.Y) < 0.995 then
                local goal = CFrame.new(camPos, target.Position)
                if goal.Position.X == goal.Position.X then -- NaN guard
                    if Settings.MaxSnapDeg > 0 then
                        Camera.CFrame = cappedLerp(Camera.CFrame, goal, Settings.MaxSnapDeg)
                    end
                end
            end
        end
    end

    local chamsSet = computeChamsSet()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if not ESPStorage[p] then createESP(p) end
            updateChams(p, chamsSet)
        end
    end
end)

