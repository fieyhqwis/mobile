local isRMBHeld = false
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        isRMBHeld = true
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        isRMBHeld = false
    end
end)

-- ------------------------------------------
-- AIMBOT (v4: no fight with the game)
-- Two paths, picked at load:
--   PC:    mousemoverel (the game's input system absorbs the delta)
--   MOBILE: ONLY aim if target is within MaxAimAngle degrees of crosshair,
--           and only do a SOFT lerp (alpha derived from angle, capped at 0.4).
--           This is the absolute cleanest way to avoid camera shake on
--           custom-camera games on mobile.
-- ------------------------------------------
RunService.RenderStepped:Connect(function()
    Camera = Workspace.CurrentCamera or Camera

    local wantAim = Settings.AimbotEnabled and (not Settings.HoldToAim or isRMBHeld)
    if wantAim then
        local target = getOnScreenTarget()
        if target then
            local cam = Workspace.CurrentCamera
            if cam then
                local mousePos = UserInputService:GetMouseLocation()
                local sp, onScreen = cam:WorldToViewportPoint(target.Position)
                if onScreen then
                    local dx = sp.X - mousePos.X
                    local dy = sp.Y - mousePos.Y
                    local screenDist = math.sqrt(dx * dx + dy * dy)

                    -- Estimate the angle from crosshair to target.
                    -- Heuristic: at default FOV, viewport width = 2*tan(fov/2)*distance.
                    -- For simplicity, we use screenDist / (viewport/2) as a proxy
                    -- for "fraction of half-screen away", and convert.
                    local fovRad = math.rad(cam.FieldOfView)
                    local pixelsPerRad = (cam.ViewportSize.Y / 2) / math.tan(fovRad / 2)
                    local angleDeg = math.deg(screenDist / pixelsPerRad)

                    if angleDeg <= Settings.MaxAimAngle then
                        if not IS_MOBILE and mousemoverel then
                            -- PC path: feed delta to the game's input pipeline
                            local strength = (Settings.Mode == "Rage") and 1.0 or 0.35
                            local maxStep = (Settings.Mode == "Rage") and 60 or 25
                            local mx = math.clamp(dx * strength, -maxStep, maxStep)
                            local my = math.clamp(dy * strength, -maxStep, maxStep)
                            if math.abs(mx) > 0.1 or math.abs(my) > 0.1 then
                                pcall(mousemoverel, mx, my)
                            end
                        else
                            -- Mobile path: SOFT lerp, alpha tied to distance-to-target.
                            -- Target close to crosshair = small alpha = minimal visible movement.
                            -- Target at edge of cone = larger alpha = still capped movement.
                            local t = math.clamp((Settings.MaxAimAngle - angleDeg) / Settings.MaxAimAngle, 0.02, 0.4)
                            local camPos = cam.CFrame.Position
                            local toTarget = target.Position - camPos
                            if toTarget.Magnitude > 0.05 and math.abs(toTarget.Unit.Y) < 0.995 then
                                local goal = CFrame.new(camPos, target.Position)
                                if goal.Position.X == goal.Position.X then
                                    cam.CFrame = cam.CFrame:Lerp(goal, t)
                                end
                            end
                        end
                    end
                end
            end
        end
        -- If no target in cone, do NOTHING. Camera left alone.
    end

    local chamsSet = computeChamsSet()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if not ESPStorage[p] then createESP(p) end
            updateChams(p, chamsSet)
        end
    end
end)

