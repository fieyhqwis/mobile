-- ==========================================
-- HARDCOK MOBILE v5 — 360° Aimbot + Chams
-- No cone. No on-screen check. Just: nearest enemy, camera locks to head.
-- Camera rotation is capped per frame so the game's custom camera
-- controller doesn't fight back and cause shake.
-- ==========================================

local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace        = game:GetService("Workspace")
local StarterGui       = game:GetService("StarterGui")

local LocalPlayer = Players.LocalPlayer
local Camera      = Workspace.CurrentCamera
local PlayerGui   = LocalPlayer:WaitForChild("PlayerGui")

local IS_MOBILE = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

-- ------------------------------------------
-- SETTINGS
-- ------------------------------------------
local Settings = {
    AimbotEnabled    = true,
    TargetPart       = "Head",    -- "Head" / "Torso" / "HumanoidRootPart"
    WallCheck        = true,
    TeamCheck        = true,
    NPCCheck         = true,
    ESPMode          = "Chams",
    ChamsEnemiesOnly = true,
    ChamsMaxDist     = 1500,

    -- Per-frame max rotation (degrees). Smaller = smoother, no shake.
    -- Larger = faster snap. 0 = no aim.
    -- 12° is a good balance: fast enough to feel instant, small enough
    -- that the game's custom camera controller absorbs it.
    MaxSnapDeg       = 12,
}

-- ------------------------------------------
-- ROLE-BASED TEAM
-- ------------------------------------------
local ROLE_GROUPS = {
    ["d_class"]          = 1,
    ["chaos_insurgency"] = 1,
    ["scientist"]        = 2,
    ["director"]         = 2,
    ["mtf"]              = 2,
    ["security"]         = 2,
}
local GROUP_COLORS = {
    [1] = Color3.fromRGB(255, 150, 58),
    [2] = Color3.fromRGB(120, 170, 255),
}

local function getRoleGroup(player)
    local role = player:GetAttribute("Role")
    if type(role) ~= "string" then return nil end
    return ROLE_GROUPS[role:lower()]
end

local function isEnemy(player)
    if not Settings.TeamCheck then return true end
    local mine, theirs = getRoleGroup(LocalPlayer), getRoleGroup(player)
    if not mine or not theirs then return true end
    return mine ~= theirs
end

local function getTeamColor(player)
    local g = getRoleGroup(player)
    return GROUP_COLORS[g] or Color3.fromRGB(255, 255, 255)
end

