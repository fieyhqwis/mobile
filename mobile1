-- INPUT
-- ------------------------------------------
local isRMBHeld = false
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        isRMBHeld = true
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        isRMBHeld = false
    end
end)

-- ------------------------------------------
-- AIMBOT (v3: no fight with the game)
-- Three rules that fix the shake:
--   1) Cone filter: if AimCone > 0, only aim at targets within AimCone degrees
--      of the current look direction. Default 90° = "in front of you".
--   2) No behind-the-back: skip if the target is > 90° off (we already test this with cone).
--   3) Cap snap distance: if MaxSnapAngle is small, the camera moves a small amount
--      per frame, which the game absorbs without fighting back.
-- ------------------------------------------
RunService.RenderStepped:Connect(function()
    Camera = Workspace.CurrentCamera or Camera

    local wantAim = Settings.AimbotEnabled and (not Settings.HoldToAim or isRMBHeld)
    if wantAim then
        local target = getBestTarget()
        if target then
            -- Cone check: skip if target is outside the cone
            local angle = angleToPoint(target.Position)
            if Settings.AimCone <= 0 or angle <= Settings.AimCone then
                local camPos = Camera.CFrame.Position
                local toTarget = target.Position - camPos
                local mag = toTarget.Magnitude
                if mag > 0.05 and math.abs(toTarget.Unit.Y) < 0.995 then
                    local goal = CFrame.new(camPos, target.Position)
                    if goal.Position.X == goal.Position.X then -- NaN guard
                        if Settings.MaxSnapAngle <= 0 then
                            -- Disabled: do nothing
                        elseif Settings.Mode == "Rage" then
                            -- Clamp the lerp alpha so the per-frame rotation <= MaxSnapAngle
                            local t = math.clamp(Settings.MaxSnapAngle / 45, 0.05, 1)
                            Camera.CFrame = Camera.CFrame:Lerp(goal, t)
                        else
                            -- Light: smooth with same cap
                            local t = math.clamp(Settings.MaxSnapAngle / 90, 0.02, 0.4)
                            Camera.CFrame = Camera.CFrame:Lerp(goal, t)
                        end
                    end
                end
            end
        end
        -- If no valid target, do NOTHING. The game camera is left alone.
    end

    local chamsSet = computeChamsSet()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if not ESPStorage[p] then createESP(p) end
            updateChams(p, chamsSet)
        end
    end
end)

