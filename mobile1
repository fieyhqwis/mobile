local function makeToggle(parent, y, label, default, onChange)
    local row = make("Frame", {
        BackgroundTransparency = 1,
        Size             = UDim2.new(1, -32, 0, 40),
        Position         = UDim2.new(0, 16, 0, y),
    }, parent)
    make("TextLabel", {
        Text             = label,
        Font             = Enum.Font.Gotham,
        TextSize         = 15,
        TextColor3       = Color3.fromRGB(230, 230, 235),
        BackgroundTransparency = 1,
        Size             = UDim2.new(1, -90, 1, 0),
        TextXAlignment   = Enum.TextXAlignment.Left,
    }, row)
    local btn = make("TextButton", {
        Text             = default and "ON" or "OFF",
        Font             = Enum.Font.GothamBold,
        TextSize         = 13,
        TextColor3       = Color3.fromRGB(255, 255, 255),
        BackgroundColor3 = default and Color3.fromRGB(60, 160, 90) or Color3.fromRGB(120, 60, 60),
        BorderSizePixel  = 0,
        Size             = UDim2.fromOffset(64, 28),
        Position         = UDim2.new(1, -64, 0.5, -14),
        Active           = true,
    }, row)
    make("UICorner", { CornerRadius = UDim.new(0, 6) }, btn)
    local state = default
    local function flip()
        state = not state
        btn.Text = state and "ON" or "OFF"
        btn.BackgroundColor3 = state and Color3.fromRGB(60, 160, 90) or Color3.fromRGB(120, 60, 60)
        if onChange then onChange(state) end
    end
    bindButtonPress(btn, flip)
    return btn
end

local function makeCycle(parent, y, label, options, default, onChange)
    local row = make("Frame", {
        BackgroundTransparency = 1,
        Size             = UDim2.new(1, -32, 0, 40),
        Position         = UDim2.new(0, 16, 0, y),
    }, parent)
    make("TextLabel", {
        Text             = label,
        Font             = Enum.Font.Gotham,
        TextSize         = 15,
        TextColor3       = Color3.fromRGB(230, 230, 235),
        BackgroundTransparency = 1,
        Size             = UDim2.new(0, 110, 1, 0),
        TextXAlignment   = Enum.TextXAlignment.Left,
    }, row)
    local idx = 1
    for i, opt in ipairs(options) do if opt == default then idx = i end end
    local btn = make("TextButton", {
        Text             = options[idx],
        Font             = Enum.Font.GothamBold,
        TextSize         = 13,
        TextColor3       = Color3.fromRGB(255, 255, 255),
        BackgroundColor3 = Color3.fromRGB(40, 50, 70),
        BorderSizePixel  = 0,
        Size             = UDim2.fromOffset(120, 28),
        Position         = UDim2.new(1, -120, 0.5, -14),
        Active           = true,
    }, row)
    make("UICorner", { CornerRadius = UDim.new(0, 6) }, btn)
    local function cycle()
        idx = idx % #options + 1
        btn.Text = options[idx]
        if onChange then onChange(options[idx]) end
    end
    bindButtonPress(btn, cycle)
    return btn
end

