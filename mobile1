-- ==========================================
-- HARDCOK MOBILE v3 — Chams + Aimbot
-- v3 fixes: no aim when no target in cone, no fight with game camera,
-- no aim when target is behind you, snap-only mode for cleanest behavior
-- ==========================================

local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace        = game:GetService("Workspace")
local StarterGui       = game:GetService("StarterGui")

local LocalPlayer = Players.LocalPlayer
local Camera      = Workspace.CurrentCamera
local PlayerGui   = LocalPlayer:WaitForChild("PlayerGui")

-- ------------------------------------------
-- SETTINGS
-- ------------------------------------------
local Settings = {
    AimbotEnabled    = true,
    Mode             = "Rage",     -- "Rage" (snap) or "Light" (smooth)
    HoldToAim        = false,
    TargetPart       = "Head",
    WallCheck        = true,
    TeamCheck        = true,
    NPCCheck         = true,
    ESPMode          = "Chams",
    ChamsEnemiesOnly = true,
    ChamsMaxDist     = 1500,

    -- NEW: cone filter — only aim at targets within this many degrees
    -- of where you're ALREADY looking. Set to 180 for "anywhere in front",
    -- 90 for "in front of you", 0 to disable.
    -- This is the main fix for "camera shakes with no target visible".
    AimCone          = 90,

    -- NEW: hard cap on snap distance per frame (in degrees).
    -- Lower = less fighting with the game camera. 0 = no snap (disabled).
    -- Default 5° = a clean small movement, no jitter.
    MaxSnapAngle     = 5,

    -- NEW: require the target to be visible AND in front of you AND
    -- pass the cone test, all of the above. If any fails, do NOTHING.
    StrictTargeting  = true,
}

-- ------------------------------------------
-- ROLE-BASED TEAM
-- ------------------------------------------
local ROLE_GROUPS = {
    ["d_class"]          = 1,
    ["chaos_insurgency"] = 1,
    ["scientist"]        = 2,
    ["director"]         = 2,
    ["mtf"]              = 2,
    ["security"]         = 2,
}
local GROUP_COLORS = {
    [1] = Color3.fromRGB(255, 150, 58),
    [2] = Color3.fromRGB(120, 170, 255),
}

local function getRoleGroup(player)
    local role = player:GetAttribute("Role")
    if type(role) ~= "string" then return nil end
    return ROLE_GROUPS[role:lower()]
end

local function isEnemy(player)
    if not Settings.TeamCheck then return true end
    local mine, theirs = getRoleGroup(LocalPlayer), getRoleGroup(player)
    if not mine or not theirs then return true end
    return mine ~= theirs
end

local function getTeamColor(player)
    local g = getRoleGroup(player)
    return GROUP_COLORS[g] or Color3.fromRGB(255, 255, 255)
end

-- ------------------------------------------
-- NPC CACHE
-- ------------------------------------------
local cachedNPCs = {}
task.spawn(function()
    while task.wait(1) do
        if not Settings.NPCCheck then
            cachedNPCs = {}
            continue
        end
        local t = {}
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") and obj:GetAttribute("Role") == nil then
                local hum = obj:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 and not Players:GetPlayerFromCharacter(obj) then
                    t[#t + 1] = obj
                end
            end
        end
        cachedNPCs = t
    end
end)

-- ------------------------------------------
-- VISIBILITY
-- ------------------------------------------
local function isVisible(targetPart, targetChar, useWall)
    if not useWall then return true end
    local cam = Workspace.CurrentCamera
    if not cam then return true end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { cam, LocalPlayer.Character }
    params.IgnoreWater = true
    params.RespectCanCollide = true
    local origin = cam.CFrame.Position
    local dir    = targetPart.Position - origin
    for _ = 1, 4 do
        local ok, result = pcall(function() return Workspace:Raycast(origin, dir, params) end)
        if not ok or not result then return true end
        if result.Instance:IsDescendantOf(targetChar) then return true end
        local transparency = 1
        pcall(function() transparency = result.Instance.Transparency end)
        if transparency < 0.5 then return false end
        local traveled  = (result.Position - origin).Magnitude
        local remaining = dir.Magnitude - traveled
        if remaining <= 0.1 then return true end
        origin = result.Position + dir.Unit * 0.1
        dir    = dir.Unit * remaining
    end
    return true
end

local function getTargetPart(char)
    return char:FindFirstChild(Settings.TargetPart)
        or char:FindFirstChild("Head")
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("Torso")
        or char:FindFirstChild("HumanoidRootPart")
end

-- ------------------------------------------
-- TARGETING
-- ------------------------------------------
local function getValidTargets()
    local t = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and isEnemy(p) then
            t[#t + 1] = p.Character
        end
    end
    if Settings.NPCCheck then
        for _, npc in ipairs(cachedNPCs) do
            if npc and npc.Parent then t[#t + 1] = npc end
        end
    end
    return t
end

-- Returns the best target, OR nil. "Best" = closest valid target.
-- The caller is responsible for the cone check and the snap itself,
-- so we can return a target even if it's behind you and let the caller decide.
local function getBestTarget()
    local cam = Workspace.CurrentCamera
    if not cam then return nil end
    local myPos = cam.CFrame.Position
    local best, bestScore = nil, math.huge
    for _, char in ipairs(getValidTargets()) do
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            local part = getTargetPart(char)
            if part then
                if isVisible(part, char, Settings.WallCheck) then
                    local score = (part.Position - myPos).Magnitude
                    if score < bestScore then bestScore, best = score, part end
                end
            end
        end
    end
    return best
end

-- Angle (in degrees) between the camera's forward vector and the vector
-- to a world point. 0 = dead-on, 180 = directly behind. Negative never.
local function angleToPoint(worldPos)
    local cam = Workspace.CurrentCamera
    if not cam then return 180 end
    local to = worldPos - cam.CFrame.Position
    local m = to.Magnitude
    if m < 0.001 then return 0 end
    local dot = cam.CFrame.LookVector:Dot(to / m)
    return math.deg(math.acos(math.clamp(dot, -1, 1)))
end

-- ------------------------------------------
-- ESP / CHAMS
-- ------------------------------------------
local ESPStorage = {}
local HIGHLIGHT_BUDGET = 24

local function removeESP(player)
    local d = ESPStorage[player]
    if not d then return end
    if d.Highlight then pcall(function() d.Highlight:Destroy() end) end
    ESPStorage[player] = nil
end

local function createESP(player)
    if player == LocalPlayer then return end
    removeESP(player)
    ESPStorage[player] = { Highlight = nil }
end

local function computeChamsSet()
    local cam = Workspace.CurrentCamera
    local want = {}
    if Settings.ESPMode ~= "Chams" or not cam then return want end
    local myPos = cam.CFrame.Position
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            if not (Settings.ChamsEnemiesOnly and not isEnemy(p)) then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart") or p.Character.PrimaryPart
                if hrp then
                    local d = (hrp.Position - myPos).Magnitude
                    if d <= Settings.ChamsMaxDist then want[p] = d end
                end
            end
        end
    end
    local n = 0
    for _ in pairs(want) do n += 1 end
    if n > HIGHLIGHT_BUDGET then
        local sorted = {}
        for p, d in pairs(want) do sorted[#sorted + 1] = { p = p, d = d } end
        table.sort(sorted, function(a, b) return a.d < b.d end)
        local keep = {}
        for i = 1, HIGHLIGHT_BUDGET do keep[sorted[i].p] = sorted[i].d end
        return keep
    end
    return want
end

local function updateChams(player, chamsSet)
    local d = ESPStorage[player]
    if not d then return end
    local char = player.Character
    if not char then return end
    local wantChams = chamsSet and chamsSet[player] ~= nil
    if d.Highlight and d.Highlight.Parent ~= char then
        pcall(function() d.Highlight:Destroy() end)
        d.Highlight = nil
    end
    if wantChams then
        if not d.Highlight then
            local hl = Instance.new("Highlight")
            hl.Name = "HC_Chams"
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = char
            d.Highlight = hl
        end
        local c = getTeamColor(player)
        d.Highlight.FillColor           = c
        d.Highlight.OutlineColor        = Color3.fromRGB(255, 255, 255)
        d.Highlight.FillTransparency    = 0.55
        d.Highlight.OutlineTransparency = 0
        d.Highlight.Enabled             = true
    else
        if d.Highlight then
            pcall(function() d.Highlight:Destroy() end)
            d.Highlight = nil
        end
    end
end

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then createESP(p) end
end
Players.PlayerAdded:Connect(createESP)
Players.PlayerRemoving:Connect(removeESP)

