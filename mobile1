-- ==========================================
-- HARDCOK MOBILE v4 — Chams + Aimbot
-- v4: zero direct camera writes when target is off-axis.
-- Uses mousemoverel on PC; on mobile, only aims when target is
-- within MaxAimAngle degrees of crosshair (no fight with the game camera).
-- ==========================================

local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace        = game:GetService("Workspace")
local StarterGui       = game:GetService("StarterGui")

local LocalPlayer = Players.LocalPlayer
local Camera      = Workspace.CurrentCamera
local PlayerGui   = LocalPlayer:WaitForChild("PlayerGui")

local IS_MOBILE = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

-- ------------------------------------------
-- SETTINGS
-- ------------------------------------------
local Settings = {
    AimbotEnabled    = true,
    Mode             = "Rage",     -- "Rage" (snap) or "Light" (smooth)
    HoldToAim        = false,
    TargetPart       = "Head",
    WallCheck        = true,
    TeamCheck        = true,
    NPCCheck         = true,
    ESPMode          = "Chams",
    ChamsEnemiesOnly = true,
    ChamsMaxDist     = 1500,

    -- The single most important setting. Only aim at targets within
    -- MaxAimAngle degrees of the crosshair. Default 25° = "roughly in front"
    -- Set to 5° for very strict (you basically have to be aimed at them).
    -- Set to 180° for "anywhere, including behind" (will cause shake).
    MaxAimAngle      = 25,
}

-- ------------------------------------------
-- ROLE-BASED TEAM
-- ------------------------------------------
local ROLE_GROUPS = {
    ["d_class"]          = 1,
    ["chaos_insurgency"] = 1,
    ["scientist"]        = 2,
    ["director"]         = 2,
    ["mtf"]              = 2,
    ["security"]         = 2,
}
local GROUP_COLORS = {
    [1] = Color3.fromRGB(255, 150, 58),
    [2] = Color3.fromRGB(120, 170, 255),
}

local function getRoleGroup(player)
    local role = player:GetAttribute("Role")
    if type(role) ~= "string" then return nil end
    return ROLE_GROUPS[role:lower()]
end

local function isEnemy(player)
    if not Settings.TeamCheck then return true end
    local mine, theirs = getRoleGroup(LocalPlayer), getRoleGroup(player)
    if not mine or not theirs then return true end
    return mine ~= theirs
end

local function getTeamColor(player)
    local g = getRoleGroup(player)
    return GROUP_COLORS[g] or Color3.fromRGB(255, 255, 255)
end

