-- NPC CACHE
-- ------------------------------------------
local cachedNPCs = {}
task.spawn(function()
    while task.wait(1) do
        if not Settings.NPCCheck then
            cachedNPCs = {}
            continue
        end
        local t = {}
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") and obj:GetAttribute("Role") == nil then
                local hum = obj:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 and not Players:GetPlayerFromCharacter(obj) then
                    t[#t + 1] = obj
                end
            end
        end
        cachedNPCs = t
    end
end)

-- ------------------------------------------
-- VISIBILITY
-- ------------------------------------------
local function isVisible(targetPart, targetChar, useWall)
    if not useWall then return true end
    local cam = Workspace.CurrentCamera
    if not cam then return true end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { cam, LocalPlayer.Character }
    params.IgnoreWater = true
    params.RespectCanCollide = true
    local origin = cam.CFrame.Position
    local dir    = targetPart.Position - origin
    for _ = 1, 4 do
        local ok, result = pcall(function() return Workspace:Raycast(origin, dir, params) end)
        if not ok or not result then return true end
        if result.Instance:IsDescendantOf(targetChar) then return true end
        local transparency = 1
        pcall(function() transparency = result.Instance.Transparency end)
        if transparency < 0.5 then return false end
        local traveled  = (result.Position - origin).Magnitude
        local remaining = dir.Magnitude - traveled
        if remaining <= 0.1 then return true end
        origin = result.Position + dir.Unit * 0.1
        dir    = dir.Unit * remaining
    end
    return true
end

local function getTargetPart(char)
    return char:FindFirstChild(Settings.TargetPart)
        or char:FindFirstChild("Head")
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("Torso")
        or char:FindFirstChild("HumanoidRootPart")
end

-- ------------------------------------------
-- TARGETING — closest by 3D distance, no cone, no on-screen check
-- ------------------------------------------
local function getValidTargets()
    local t = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and isEnemy(p) then
            t[#t + 1] = p.Character
        end
    end
    if Settings.NPCCheck then
        for _, npc in ipairs(cachedNPCs) do
            if npc and npc.Parent then t[#t + 1] = npc end
        end
    end
    return t
end

local function getClosestTarget()
    local cam = Workspace.CurrentCamera
    if not cam then return nil end
    local myPos = cam.CFrame.Position
    local best, bestScore = nil, math.huge
    for _, char in ipairs(getValidTargets()) do
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            local part = getTargetPart(char)
            if part then
                if isVisible(part, char, Settings.WallCheck) then
                    local score = (part.Position - myPos).Magnitude
                    if score < bestScore then bestScore, best = score, part end
                end
            end
        end
    end
    return best
end

-- ------------------------------------------
-- CAPPED LERP — moves toward target CFrame, but the rotation per
-- frame is bounded by MaxSnapDeg. This is the trick that prevents
-- the camera shake: small steps per frame are absorbed by the
-- game's custom camera controller; big jumps would fight it.
-- ------------------------------------------
local function cappedLerp(current, goal, maxDeg)
    local curLook  = current.LookVector
    local goalLook = goal.LookVector
    local dot = math.clamp(curLook:Dot(goalLook), -1, 1)
    local angle = math.deg(math.acos(dot))
    if angle < 0.5 then
        -- Already looking there. Snap to exact orientation.
        return CFrame.new(current.Position) * (goal - goal.Position)
    end
    local t = math.clamp(maxDeg / angle, 0.02, 1)
    -- Lerp position normally, slerp rotation by t
    local pos = current.Position:Lerp(goal.Position, t)
    local rot = current:ToObjectSpace(CFrame.new()).LookVector
    local goalRot = goal:ToObjectSpace(CFrame.new()).LookVector
    -- Simpler: just lerp the whole CFrame; the cap on t handles the speed.
    return current:Lerp(goal, t)
end

-- ------------------------------------------
-- ESP / CHAMS
-- ------------------------------------------
local ESPStorage = {}
local HIGHLIGHT_BUDGET = 24

local function removeESP(player)
    local d = ESPStorage[player]
    if not d then return end
    if d.Highlight then pcall(function() d.Highlight:Destroy() end) end
    ESPStorage[player] = nil
end

local function createESP(player)
    if player == LocalPlayer then return end
    removeESP(player)
    ESPStorage[player] = { Highlight = nil }
end

local function computeChamsSet()
    local cam = Workspace.CurrentCamera
    local want = {}
    if Settings.ESPMode ~= "Chams" or not cam then return want end
    local myPos = cam.CFrame.Position
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            if not (Settings.ChamsEnemiesOnly and not isEnemy(p)) then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart") or p.Character.PrimaryPart
                if hrp then
                    local d = (hrp.Position - myPos).Magnitude
                    if d <= Settings.ChamsMaxDist then want[p] = d end
                end
            end
        end
    end
    local n = 0
    for _ in pairs(want) do n += 1 end
    if n > HIGHLIGHT_BUDGET then
        local sorted = {}
        for p, d in pairs(want) do sorted[#sorted + 1] = { p = p, d = d } end
        table.sort(sorted, function(a, b) return a.d < b.d end)
        local keep = {}
        for i = 1, HIGHLIGHT_BUDGET do keep[sorted[i].p] = sorted[i].d end
        return keep
    end
    return want
end

local function updateChams(player, chamsSet)
    local d = ESPStorage[player]
    if not d then return end
    local char = player.Character
    if not char then return end
    local wantChams = chamsSet and chamsSet[player] ~= nil
    if d.Highlight and d.Highlight.Parent ~= char then
        pcall(function() d.Highlight:Destroy() end)
        d.Highlight = nil
    end
    if wantChams then
        if not d.Highlight then
            local hl = Instance.new("Highlight")
            hl.Name = "HC_Chams"
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = char
            d.Highlight = hl
        end
        local c = getTeamColor(player)
        d.Highlight.FillColor           = c
        d.Highlight.OutlineColor        = Color3.fromRGB(255, 255, 255)
        d.Highlight.FillTransparency    = 0.55
        d.Highlight.OutlineTransparency = 0
        d.Highlight.Enabled             = true
    else
        if d.Highlight then
            pcall(function() d.Highlight:Destroy() end)
            d.Highlight = nil
        end
    end
end

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then createESP(p) end
end
Players.PlayerAdded:Connect(createESP)
Players.PlayerRemoving:Connect(removeESP)

